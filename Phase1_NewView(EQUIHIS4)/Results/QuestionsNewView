/*==========================================================================
  11. COLUMN LEVEL ATTRIBUTE VALIDATION

  Replace STATUS with each non-key column and execute.
  Example shown below.
==========================================================================*/
WITH FABRIC AS
(
    SELECT *
    FROM MES_Analytics.vw_EQUIPHIS4
    WHERE DATE_TIME BETWEEN DATEADD(DAY,-365,'2026-09-28 23:59:59')
                        AND '2026-09-28 23:59:59'
)
SELECT
    p.MACHINE,
    p.DATE_TIME,
    p.LINEORDER,
    p.STATUS AS PROD_STATUS,
    f.STATUS AS FABRIC_STATUS
FROM MES_Analytics.TrainingVision_EQUIPHIS4 p
INNER JOIN FABRIC f
       ON p.MACHINE = f.MACHINE
      AND p.DATE_TIME = f.DATE_TIME
      AND p.LINEORDER = f.LINEORDER
WHERE ISNULL(CAST(p.STATUS AS VARCHAR(MAX)), '')
   <> ISNULL(CAST(f.STATUS AS VARCHAR(MAX)), '');


