/***************************************************************************************
 DATA VALIDATION : TrainingVision_EQUIPHIS4 (PROD) vs vw_EQUIPHIS4 (FABRIC)

 IMPORTANT:
 Production contains only 1 year of data.
 Fabric contains historical + future data.

 Applied this common validation window to Fabric:

    DATE_TIME >= DATEADD(DAY,-365,'2026-09-28 23:59:59')
    DATE_TIME <= '2026-09-28 23:59:59'

 Expected Range:
    2025-09-28 23:59:59
    TO
    2026-09-28 23:59:59
****************************************************************************************/

WITH FABRIC AS
(
    SELECT *
    FROM MES_Analytics.vw_EQUIPHIS4
    WHERE DATE_TIME BETWEEN DATEADD(DAY,-365,'2026-09-28 23:59:59')
                        AND '2026-09-28 23:59:59'
),
PROD AS
(
    SELECT *
    FROM MES_Analytics.TrainingVision_EQUIPHIS4
)

/*==========================================================================
  1. ROW COUNT VALIDATION
==========================================================================*/
SELECT 'PROD' AS Source, COUNT(*) AS Row FROM PROD
UNION ALL
SELECT 'FABRIC' AS Source, COUNT(*) AS Row FROM FABRIC;


/*==========================================================================
  2. DATE RANGE VALIDATION
==========================================================================*/
SELECT
    'PROD' AS Source,
    MIN(DATE_TIME) AS MinDate,
    MAX(DATE_TIME) AS MaxDate
FROM PROD

UNION ALL

SELECT
    'FABRIC' AS Source,
    MIN(DATE_TIME) AS MinDate,
    MAX(DATE_TIME) AS MaxDate
FROM FABRIC;


/*==========================================================================
  3. RECORDS IN PROD NOT IN FABRIC
==========================================================================*/
WITH FABRIC AS
(
    SELECT *
    FROM MES_Analytics.vw_EQUIPHIS4
    WHERE DATE_TIME BETWEEN DATEADD(DAY,-365,'2026-09-28 23:59:59')
                        AND '2026-09-28 23:59:59'
)
SELECT *
FROM MES_Analytics.TrainingVision_EQUIPHIS4

EXCEPT

SELECT *
FROM FABRIC;


/*==========================================================================
  4. RECORDS IN FABRIC NOT IN PROD
==========================================================================*/
WITH FABRIC AS
(
    SELECT *
    FROM MES_Analytics.vw_EQUIPHIS4
    WHERE DATE_TIME BETWEEN DATEADD(DAY,-365,'2026-09-28 23:59:59')
                        AND '2026-09-28 23:59:59'
)
SELECT *
FROM FABRIC

EXCEPT

SELECT *
FROM MES_Analytics.TrainingVision_EQUIPHIS4;


/*==========================================================================
  5. OVERALL RECONCILIATION SUMMARY
==========================================================================*/
WITH FABRIC AS
(
    SELECT *
    FROM MES_Analytics.vw_EQUIPHIS4
    WHERE DATE_TIME BETWEEN DATEADD(DAY,-365,'2026-09-28 23:59:59')
                        AND '2026-09-28 23:59:59'
),
PRODONLY AS
(
    SELECT *
    FROM MES_Analytics.TrainingVision_EQUIPHIS4

    EXCEPT

    SELECT *
    FROM FABRIC
),
FABRICONLY AS
(
    SELECT *
    FROM FABRIC

    EXCEPT

    SELECT *
    FROM MES_Analytics.TrainingVision_EQUIPHIS4
)
SELECT
    (SELECT COUNT(*) FROM MES_Analytics.TrainingVision_EQUIPHIS4) AS ProdRows,
    (SELECT COUNT(*) FROM FABRIC) AS FabricRows,
    (SELECT COUNT(*) FROM PRODONLY) AS OnlyInProd,
    (SELECT COUNT(*) FROM FABRICONLY) AS OnlyInFabric;


/*==========================================================================
  6. DUPLICATE KEY CHECK - PROD
==========================================================================*/
SELECT
    MACHINE,
    DATE_TIME,
    LINEORDER,
    COUNT(*) AS DuplicateCount
FROM MES_Analytics.TrainingVision_EQUIPHIS4
GROUP BY
    MACHINE,
    DATE_TIME,
    LINEORDER
HAVING COUNT(*) > 1;


/*==========================================================================
  7. DUPLICATE KEY CHECK - FABRIC
==========================================================================*/
WITH FABRIC AS
(
    SELECT *
    FROM MES_Analytics.vw_EQUIPHIS4
    WHERE DATE_TIME BETWEEN DATEADD(DAY,-365,'2026-09-28 23:59:59')
                        AND '2026-09-28 23:59:59'
)
SELECT
    MACHINE,
    DATE_TIME,
    LINEORDER,
    COUNT(*) AS DuplicateCount
FROM FABRIC
GROUP BY
    MACHINE,
    DATE_TIME,
    LINEORDER
HAVING COUNT(*) > 1;


/*==========================================================================
  8. DISTINCT BUSINESS KEY COUNTS
==========================================================================*/
SELECT
    'PROD' AS Source,
    COUNT(*) AS DistinctKeys
FROM
(
    SELECT DISTINCT
        MACHINE,
        DATE_TIME,
        LINEORDER
    FROM MES_Analytics.TrainingVision_EQUIPHIS4
) X

UNION ALL

SELECT
    'FABRIC' AS Source,
    COUNT(*) AS DistinctKeys
FROM
(
    SELECT DISTINCT
        MACHINE,
        DATE_TIME,
        LINEORDER
    FROM MES_Analytics.vw_EQUIPHIS4
    WHERE DATE_TIME BETWEEN DATEADD(DAY,-365,'2026-09-28 23:59:59')
                        AND '2026-09-28 23:59:59'
) X;


/*==========================================================================
  9. SCHEMA VALIDATION : PROD NOT IN FABRIC
==========================================================================*/
SELECT
    COLUMN_NAME,
    DATA_TYPE,
    ORDINAL_POSITION
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 'TrainingVision_EQUIPHIS4'

EXCEPT

SELECT
    COLUMN_NAME,
    DATA_TYPE,
    ORDINAL_POSITION
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 'vw_EQUIPHIS4';


/*==========================================================================
  10. SCHEMA VALIDATION : FABRIC NOT IN PROD
==========================================================================*/
SELECT
    COLUMN_NAME,
    DATA_TYPE,
    ORDINAL_POSITION
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 'vw_EQUIPHIS4'

EXCEPT

SELECT
    COLUMN_NAME,
    DATA_TYPE,
    ORDINAL_POSITION
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 'TrainingVision_EQUIPHIS4';


/*==========================================================================
  11. COLUMN LEVEL ATTRIBUTE VALIDATION

  Replace STATUS with each non-key column and execute.
  Example shown below.
==========================================================================*/
WITH FABRIC AS
(
    SELECT *
    FROM MES_Analytics.vw_EQUIPHIS4
    WHERE DATE_TIME BETWEEN DATEADD(DAY,-365,'2026-09-28 23:59:59')
                        AND '2026-09-28 23:59:59'
)
SELECT
    p.MACHINE,
    p.DATE_TIME,
    p.LINEORDER,
    p.STATUS AS PROD_STATUS,
    f.STATUS AS FABRIC_STATUS
FROM MES_Analytics.TrainingVision_EQUIPHIS4 p
INNER JOIN FABRIC f
       ON p.MACHINE = f.MACHINE
      AND p.DATE_TIME = f.DATE_TIME
      AND p.LINEORDER = f.LINEORDER
WHERE ISNULL(CAST(p.STATUS AS VARCHAR(MAX)), '')
   <> ISNULL(CAST(f.STATUS AS VARCHAR(MAX)), '');


/*==========================================================================
  12. FINAL PASS / FAIL SUMMARY
==========================================================================*/
WITH FABRIC AS
(
    SELECT *
    FROM MES_Analytics.vw_EQUIPHIS4
    WHERE DATE_TIME BETWEEN DATEADD(DAY,-365,'2026-09-28 23:59:59')
                        AND '2026-09-28 23:59:59'
),
PRODONLY AS
(
    SELECT *
    FROM MES_Analytics.TrainingVision_EQUIPHIS4

    EXCEPT

    SELECT *
    FROM FABRIC
),
FABRICONLY AS
(
    SELECT *
    FROM FABRIC

    EXCEPT

    SELECT *
    FROM MES_Analytics.TrainingVision_EQUIPHIS4
)
SELECT
    CASE
        WHEN (SELECT COUNT(*) FROM MES_Analytics.TrainingVision_EQUIPHIS4)
           = (SELECT COUNT(*) FROM FABRIC)
        THEN 'PASS'
        ELSE 'FAIL'
    END AS RowCountValidation,

    CASE
        WHEN (SELECT COUNT(*) FROM PRODONLY) = 0
         AND (SELECT COUNT(*) FROM FABRICONLY) = 0
        THEN 'PASS'
        ELSE 'FAIL'
    END AS DataValidation;
