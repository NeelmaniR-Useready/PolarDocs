/***************************************************************************************
 DATA VALIDATION : TrainingVision_EQUIPHIS4 (PROD) vs vw_EQUIPHIS4 (FABRIC)

 IMPORTANT:
 Production contains only 1 year of data.
 Fabric contains historical + future data.

 Applied this common validation window to Fabric:

    DATE_TIME >= DATEADD(DAY,-365,'2026-09-28 23:59:59')
    DATE_TIME <= '2026-09-28 23:59:59'

 Expected Range:
    2025-09-28 23:59:59
    TO
    2026-09-28 23:59:59
****************************************************************************************/

WITH FABRIC AS
(
    SELECT *
    FROM MES_Analytics.vw_EQUIPHIS4
    WHERE DATE_TIME BETWEEN DATEADD(DAY,-365,'2026-09-28 23:59:59')
                        AND '2026-09-28 23:59:59'
),
PROD AS
(
    SELECT *
    FROM MES_Analytics.TrainingVision_EQUIPHIS4
)

